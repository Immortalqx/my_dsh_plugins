# Cordis patch template. Substitute __REPO_PATH__ with the absolute path of
# your ~/.dsh/plugins directory before installing. The README has the exact
# install steps; this file's only role is to carry the placeholder token.

- id: web-search-deepseek
  disabled: true

- id: tool-web
  disabled: true

- insert:
    - id: web-search-mmx
      name: 'file://__REPO_PATH__/web-search-mmx/src/index.mjs'
      inject: ['tools']

    - id: web-fetch-local
      name: 'file://__REPO_PATH__/web-fetch-local/src/index.mjs'
      inject: ['tools']